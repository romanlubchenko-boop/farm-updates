# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...        # від @BotFather
OWNER_ID=111111111                      # ваш Telegram ID (розробник)
ADMIN_ID=222222222                      # Telegram ID замовника
CLIENT_NAME=ТОВ Замовник

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low                    # low | medium | high
# ціни моделі, $ за 1 млн токенів (Sonnet 5.5)
PRICE_INPUT=2.0
PRICE_OUTPUT=10.0
PRICE_CACHE_READ=0.20
PRICE_CACHE_WRITE=2.50

# Білінг
MARGIN_PERCENT=36                       # 30% маржа + 6% податки
SUBSCRIPTION_UAH=700
USD_RATE=41.5                           # змінюється командою /rate без перезапуску
ALERT_USD=10                            # попередити власника, коли витрати API за місяць досягнуть
OWNER_DETAILS=ФОП Прізвище І.П., IBAN UA00 0000 0000 0000 0000 0000 0000, призначення: обслуговування бота

# Інше
TZ=Europe/Kyiv
DB_PATH=bot.db
